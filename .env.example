# ==========================================
# FRONTEND (.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Sumpytrumpy

# ==========================================
# BACKEND (.env)
# ==========================================
# Server
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# OmniRoute Configuration
# Get these from https://omniroute.online
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=your-omniroute-api-key

# Default Model Provider
OMNIROUTE_DEFAULT_MODEL=gpt-4-turbo
OMNIROUTE_DEFAULT_PROVIDER=openai

# Web Search Integration
WEB_SEARCH_ENABLED=true
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_ENGINE_ID=your-engine-id

# Alternative: Bing Search
# BING_SEARCH_API_KEY=your-bing-api-key

# Agent Configuration
ENABLE_AGENTS=true
AGENT_TIMEOUT=30000

# CORS & Security
CORS_ORIGIN=http://localhost:3000
MAX_REQUEST_SIZE=10mb

# Logging
LOG_LEVEL=info
